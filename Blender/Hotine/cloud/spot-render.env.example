#!/usr/bin/env bash
# Copy to spot-render.env and edit values.

# -- AWS account / network ----------------------------------------------------
AWS_REGION="eu-west-2"
S3_BUCKET="replace-with-your-bucket"
S3_PREFIX="blender/hotine"

# GPU-capable Linux AMI with NVIDIA drivers (required).
AMI_ID="ami-xxxxxxxxxxxxxxxxx"

# Network placement for workers.
SUBNET_ID="subnet-xxxxxxxxxxxxxxxxx"
# Or provide multiple subnets (space or comma separated) to widen Spot pools.
# SUBNET_IDS="subnet-xxxxxxxxxxxxxxxxx subnet-yyyyyyyyyyyyyyyyy"
# Set either SECURITY_GROUP_ID (single) or SECURITY_GROUP_IDS (multi).
SECURITY_GROUP_ID="sg-xxxxxxxxxxxxxxxxx"
# SECURITY_GROUP_IDS="sg-xxxxxxxxxxxxxxxxx sg-yyyyyyyyyyyyyyyyy"

# EC2 instance profile name (not ARN), with S3 read/write permissions.
INSTANCE_PROFILE_NAME="hotine-render-worker"

# Optional SSH key pair; leave empty for no SSH access.
KEY_NAME=""

# -- Spot fleet shape ---------------------------------------------------------
# Ordered preference list. The launcher will try each in order per shard.
INSTANCE_TYPES="g5.xlarge g6.xlarge g4dn.xlarge"

# Optional USD/hour cap for Spot bids. Leave empty for on-demand ceiling.
SPOT_MAX_PRICE=""

# Root-only storage; deleted automatically on instance termination.
ROOT_VOLUME_GB="120"
# Swap safety net for memory-heavy renders (0 disables swap creation).
SWAP_GB="32"

# Number of parallel workers (shards).
WORKER_COUNT="4"

# -- Render parameters --------------------------------------------------------
# Flythrough final render defaults from trig_pillar.py.
TOTAL_FRAMES="1788"
FPS="30"
FRAME_JUMP="1"
# Upload new frames during render every N seconds (0 disables periodic sync).
FRAME_SYNC_INTERVAL_SEC="30"
TRIG_ANIMATION="flythrough"       # flythrough | bracket
TRIG_RENDER_QUALITY="final"       # final | final_4k | draft
TRIG_HIDE_TERRAIN=""

# -- Blender install on workers -----------------------------------------------
BLENDER_ARCHIVE="blender-4.3.2-linux-x64.tar.xz"
BLENDER_DOWNLOAD_URL="https://download.blender.org/release/Blender4.3/blender-4.3.2-linux-x64.tar.xz"

# -- Local workspace paths (defaults are usually fine) ------------------------
HOTINE_DIR="/home/ianh/dev/platform/Blender/Hotine"
RUNS_DIR="/home/ianh/dev/platform/Blender/Hotine/cloud/runs"
